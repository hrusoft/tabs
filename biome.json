{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.claude/skills/port-to-native/scripts/parity_page.html",
      "!native/Visual/golden",
      "!native/Visual/scenarios",
      "!native/Sources/Tabs/Assets.xcassets"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noShadow": "error",
        "noUnnecessaryConditions": "error"
      },
      "complexity": {
        "noUselessUndefined": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/renderer/**",
        "packages/plugin-*/renderer/**",
        "packages/plugin-*/settings/**",
        "packages/plugin-*/testing/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
