{
  "name": "tabs",
  "version": "2026.09.02",
  "description": "Tabs — a recursive tab manager for arbitrary content",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Hrusoft",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "postinstall": "npm run rebuild",
    "rebuild": "electron-rebuild -o node-pty",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:cycles": "npx -y madge@8.0.0 --circular --extensions ts,tsx --ts-config tsconfig.web.json src",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:electron": "npm run build && playwright test --project=electron",
    "test:e2e:browser": "playwright test --project=browser",
    "check": "npm run typecheck && npm run lint && npm run lint:cycles && npm run test && npm run test:e2e",
    "pack": "npm run build && electron-builder --dir",
    "release": "bash ./scripts/release.sh",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:universal": "npm run build && electron-builder --mac --universal --publish never"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@electron-toolkit/utils": "4.0.0",
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-resizable-panels": "4.12.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "zustand": "5.0.14"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  }
}
