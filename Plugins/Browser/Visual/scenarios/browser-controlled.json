                  "url": "about:blank"
                }
              }
            ],
            "sizes": [
              0.5,
              0.5
            ]
          }
        }
      ],
      "activeTabId": "tab-main"
    },
    "activePaneId": "leaf-a",
    "floating": []
  },
  "content": {
    "leaf-b": {
      "page": "#2b3a55",
      "address": "https://example.com/docs/getting-started",
      "title": "Example Domain"
    }
  }
