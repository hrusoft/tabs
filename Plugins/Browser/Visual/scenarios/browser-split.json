{
  "description": "Split [empty pane A | browser B], A active: B's header holds the nav chrome in half the width; B is inactive (dimmed content, no accent outline).",
  "size": {
    "width": 1000,
    "height": 500
  },
  "settings": {
    "colorTheme": "dark"
  },
  "layout": {
    "version": 1,
    "root": {
      "id": "root",
      "type": "tabs",
      "tabs": [
        {
          "id": "tab-main",
          "title": "Tabs",
          "content": {
            "id": "split-1",
            "type": "split",
            "direction": "horizontal",
            "children": [
              {
                "id": "leaf-a",
                "type": "empty",
                "config": {}
              },
              {
                "id": "leaf-web",
                "type": "browser",
                "config": {
                  "url": "about:blank"
                }
              }
            ],
            "sizes": [
              0.5,
              0.5
            ]
          }
        }
      ],
      "activeTabId": "tab-main"
    },
    "activePaneId": "leaf-a",
    "floating": []
  },
  "content": {
    "leaf-web": {
      "page": "#2b3a55",
      "address": "https://example.com/docs/getting-started",
      "title": "Example Domain"
    }
  }
}
