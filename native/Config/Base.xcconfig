// Signing defaults for local development: ad-hoc ("Sign to Run Locally"),
// no Hardened Runtime.
//
// Hardened Runtime turns on library validation, which only admits images signed
// by the same Team ID. Ad-hoc signatures carry no Team ID, so an ad-hoc build
// with Hardened Runtime refuses its own SDK framework at launch ("mapping
// process and mapped file (non-platform) have different Team IDs").
//
// For a distributable build, create Config/Signing.local.xcconfig (gitignored):
//
//   DEVELOPMENT_TEAM = <your team id>
//   CODE_SIGN_IDENTITY = Developer ID Application
//   ENABLE_HARDENED_RUNTIME = YES
//
// Because core, the SDK and every plugin are signed by that one team, library
// validation passes and no disable-library-validation entitlement is needed.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO

#include? "Signing.local.xcconfig"

// The version: MARKETING_VERSION and CURRENT_PROJECT_VERSION, both the root
// package.json's "version" verbatim (the Electron app's, bumped by
// scripts/release.sh), so both apps report the same string everywhere. `make
// project` writes this file; every image's Info.plist reads the two settings
// (Scripts/verify-app.sh checks).
#include "../build/Version.xcconfig"
