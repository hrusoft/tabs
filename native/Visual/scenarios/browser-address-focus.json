{
  "description": "browser-default with the address input focused (by script; the pointer stays away): the bar's border is the accent color, the caret is hidden by the capture.",
  "size": {
    "width": 900,
    "height": 500
  },
  "settings": {
    "colorTheme": "dark"
  },
  "layout": {
    "version": 1,
    "root": {
      "id": "root",
      "type": "tabs",
      "tabs": [
        {
          "id": "tab-main",
          "title": "Tabs",
          "content": {
            "id": "leaf-web",
            "type": "browser",
            "title": "Example Domain",
            "config": {
              "url": "https://example.com/docs/getting-started"
            }
          }
        }
      ],
      "activeTabId": "tab-main"
    },
    "activePaneId": "leaf-web",
    "floating": []
  },
  "browser": {
    "leaf-web": {
      "page": "#2b3a55",
      "focusAddress": true
    }
  }
}
