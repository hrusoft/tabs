{
  // Core's Node-side project: main, preload, the process-agnostic src/shared,
  // e2e, the root configs, and every package's shared/ and main/ *tests*
  // (package projects cover shipped code only — see
  // packages/tsconfig.package.json). Package sources arrive through the
  // references below, never through `include`: a composite project that
  // globbed them in would own files another project already owns.
  "extends": ["@electron-toolkit/tsconfig/tsconfig.node.json", "./tsconfig.base.json"],
  "include": [
    "electron.vite.config.ts",
    "vite.harness.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "alias.config.ts",
    "externals.config.ts",
    "app.config.ts",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/plugins/index.ts",
    "packages/*/shared/**/__tests__/**/*",
    "packages/*/main/**/__tests__/**/*",
    "e2e/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuildcache/core-node",
    "rootDir": ".",
    "types": ["electron-vite/node", "node"]
  },
  "references": [
    { "path": "./packages/plugin-sdk/shared" },
    { "path": "./packages/plugin-sdk/main" },
    { "path": "./packages/plugin-terminal/shared" },
    { "path": "./packages/plugin-terminal/main" },
    { "path": "./packages/plugin-browser/shared" },
    { "path": "./packages/plugin-browser/main" },
    { "path": "./packages/plugin-gitTree/shared" },
    { "path": "./packages/plugin-gitTree/main" }
  ]
}
