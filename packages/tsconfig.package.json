{
  // Base for every workspace package's composite sub-projects (one per
  // process boundary: shared, main, renderer — settings/ and testing/ ride
  // the renderer one). Each leaf sets its own outDir, which must stay in the
  // leaf: `extends` resolves a relative outDir against the file that names it.
  // Emit always goes to the gitignored .tsbuildcache/ at the repo root, never
  // beside sources — see CLAUDE.md's plugin-SDK workspace entry.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    // Typechecking is the only job: nothing consumes the JS, and each
    // package's package.json#exports serves its .ts sources directly.
    "emitDeclarationOnly": true
  }
}
