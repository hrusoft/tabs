{
  // settings/ (and testing/, where a package has one) share this DOM+React
  // project rather than getting their own: they need exactly this lib/jsx, and
  // package.json#exports / the per-entry globs still keep each an import-graph
  // boundary of its own — that separation is Vite's to enforce, not tsc's.
  // `vite/client` supplies the ambient `*.css` / `*?raw` module declarations
  // the app's env.d.ts gives core's web project.
  "extends": "../../tsconfig.package.json",
  "compilerOptions": {
    "outDir": "../../../.tsbuildcache/plugin-terminal/renderer",
    "rootDir": "..",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "references": [
    {
      "path": "../shared"
    },
    {
      "path": "../../plugin-sdk/shared"
    },
    {
      "path": "../../plugin-sdk/renderer"
    }
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../settings/**/*.ts",
    "../settings/**/*.tsx",
    "../testing/**/*.ts"
  ],
  "exclude": ["**/__tests__/**"]
}
