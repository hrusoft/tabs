{
  "description": "split-horizontal with a bell on A, the active pane (kept, as when the window is unfocused): the bell icon in A's header, and A's content outline in the bell color with an inner glow instead of the accent. The root tab shows the bell. B is plain.",
  "size": {
    "width": 1200,
    "height": 800
  },
  "settings": {
    "colorTheme": "dark"
  },
  "signals": {
    "leaf-a": [
      "bell"
    ]
  },
  "layout": {
    "version": 1,
    "root": {
      "id": "root",
      "type": "tabs",
      "tabs": [
        {
          "id": "tab-main",
          "title": "Tabs",
          "content": {
            "id": "split-1",
            "type": "split",
            "direction": "horizontal",
            "children": [
              {
                "id": "leaf-a",
                "type": "empty",
                "config": {}
              },
              {
                "id": "leaf-b",
                "type": "empty",
                "config": {}
              }
            ],
            "sizes": [
              0.5,
              0.5
            ]
          }
        }
      ],
      "activeTabId": "tab-main"
    },
    "activePaneId": "leaf-a",
    "floating": []
  }
}
