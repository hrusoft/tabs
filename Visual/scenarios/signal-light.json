            "children": [
              {
                "id": "leaf-a",
                "type": "empty",
                "config": {}
              },
              {
                "id": "leaf-b",
                "type": "empty",
                "config": {}
              }
            ],
            "sizes": [
              0.5,
              0.5
            ]
          }
        }
      ],
      "activeTabId": "tab-main"
