{
  // Core's renderer-side project: the pane/Settings/About windows, the
  // process-agnostic src/shared, and every package's renderer-side *tests*
  // (package projects cover shipped code only — see
  // packages/tsconfig.package.json). Package sources arrive through the
  // references below, never through `include`.
  "extends": ["@electron-toolkit/tsconfig/tsconfig.web.json", "./tsconfig.base.json"],
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/preload/*.d.ts",
    "src/plugins/index.ts",
    "externals.config.ts",
    "app.config.ts",
    "packages/*/renderer/**/__tests__/**/*",
    "packages/*/settings/**/__tests__/**/*",
    "packages/*/testing/**/__tests__/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuildcache/core-web",
    "rootDir": ".",
    "jsx": "react-jsx",
    // Stated, not inherited: `types` defaults to [] under this TypeScript,
    // and this project used to get Node's globals only by accident, through
    // electron.d.ts's `/// <reference types="node" />` pulled in by browser
    // renderer files it globbed in. src/shared's tests (node:fs, node:path)
    // and the vitest polyfills need them.
    "types": ["node"],
    // The one hand-synced copy of the @shared alias — JSON can't import
    // alias.config.ts, which is where the three vite/vitest configs get it.
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "references": [
    { "path": "./packages/plugin-sdk/shared" },
    { "path": "./packages/plugin-sdk/renderer" },
    { "path": "./packages/plugin-terminal/shared" },
    { "path": "./packages/plugin-terminal/renderer" },
    { "path": "./packages/plugin-browser/shared" },
    { "path": "./packages/plugin-browser/renderer" },
    { "path": "./packages/plugin-gitTree/shared" },
    { "path": "./packages/plugin-gitTree/renderer" }
  ]
}
