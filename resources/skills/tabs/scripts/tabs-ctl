#!/usr/bin/env node
'use strict'

// Deliberately no top-level `require`/`import` for node:net: once installed,
// this file is symlinked into an agent's own skills directory (see
// src/main/skills.ts), where whether Node treats an extension-less script as
// CommonJS or ESM depends on the nearest ancestor package.json — which
// varies by install location and isn't under this project's control. Dynamic
// `import()` inside an async function works under both module systems, so
// module-type detection can't break this script wherever it ends up.

/**
 * Every command, as data rather than as a chain of hand-written branches.
 *
 * This table *is* the parser — `buildRequest` below walks it to validate flags
 * and assemble the wire request — which is what keeps `describe` honest. A
 * schema emitted alongside a separate hand-rolled parser would just be a
 * fourth thing to keep in sync (after the ControlRequest union, the two
 * process-side switches, and SKILL.md); a schema the parser is derived from
 * cannot disagree with what the command actually accepts.
 *
 * Per-flag fields:
 *   wire        field name in the protocol request (defaults to the flag name)
 *   required    reject the call when absent
 *   type        string (default) | number | boolean | json | csv
 *   enum        allowed values, checked before sending
 *   min         numeric floor, rejected below it before sending (only for
 *               floors the app doesn't own — documented app-side clamps like
 *               --timeout's carry none)
 *   default     applied when the flag is absent
 *   schema      JSON Schema for the wire value, when it isn't a plain scalar
 *   placeholder usage-string stand-in, when `<flagname>` reads badly
 *
 * `target: true` marks the verbs taking an `ElementTarget` — a union of
 * `{ref}` and `{x,y}` that flat flags can't express, and the one shape here
 * that needs its own builder.
 */
const TARGET_SCHEMA = {
  oneOf: [
    {
      type: 'object',
      properties: { ref: { type: 'string' } },
      required: ['ref'],
      additionalProperties: false
    },
    {
      type: 'object',
      properties: { x: { type: 'number' }, y: { type: 'number' } },
      required: ['x', 'y'],
      additionalProperties: false
    },
    {
      // Semantic: matched in the page against the same role/accessible-name
      // extraction read-page reports, and/or a CSS selector. Criteria
      // AND-combine; ambiguity fails listing candidates; nth (0-based,
      // document order) picks among them.
      type: 'object',
      properties: {
        role: { type: 'string' },
        name: { type: 'string' },
        selector: { type: 'string' },
        nth: { type: 'number' }
      },
      anyOf: [{ required: ['role'] }, { required: ['name'] }, { required: ['selector'] }],
      additionalProperties: false
    }
  ]
}

/**
 * Wire caps restated from src/shared (externalControl.ts and
 * content/browser/externalControl.ts) — the app enforces them, this file only
 * states them. `describe` emits them under `limits`, and
 * tabsCtlDescribe.test.ts pins each against the shared constant, so a cap
 * changed in the app fails a test instead of leaving this CLI (and the
 * SKILL.md prose quoting it) quietly wrong.
 */
const LIMITS = {
  maxBatchRequests: 50,
  pageTextDefaultMax: 50000,
  pageTextHardMax: 200000,
  waitDefaultTimeoutMs: 10000,
  waitMaxTimeoutMs: 300000,
  waitIdleQuietMs: 500,
  waitDefaultPollMs: 250,
  networkBodyMax: 16384,
  networkBodyHardMax: 2000000,
  networkRequestCapacity: 500,
  executeResultMax: 50000
}

/**
 * Fragments the command table below shares. Stated once each because the table
 * is the parser *and* the documentation: a field added to one copy of a
 * repeated result shape and not the others is a `describe` payload that lies
 * about the verbs it missed, with nothing to catch it. Spread (`...`) rather
 * than nested, so each verb's key order — and therefore its `describe` output —
 * stays exactly what it was.
 */

/** The pane flag every verb that targets one takes. */
const PANE_FLAG = { wire: 'targetPaneId', required: true, placeholder: 'paneId' }

/** A viewport rect, as every verb that reports one reports it. */
const RECT = { x: 'number', y: 'number', width: 'number', height: 'number' }

/** What every read verb reports about how far along the page is (see the readiness fields in SKILL.md). */
const PAGE_STATE = {
  isLoading: 'boolean',
  readyState: 'string',
  settled: 'boolean',
  frames: 'number',
  shadowRoots: 'number'
}

/**
 * Where a navigation verb's page ended up. Each verb states its own
 * `loaded`/`loadError` before these and its own `redirected`/`retried` after,
 * because which of those it reports differs — navigate fails outright on a load
 * error where reload reports one.
 */
const SETTLED_PAGE = {
  url: 'string',
  title: 'string',
  titleFromUrl: 'boolean',
  status: 'number',
  statusText: 'string'
}

/**
 * The filter vocabularies read-network accepts, restated from
 * src/plugins/browser/main/networkLog.ts (NETWORK_METHODS /
 * NETWORK_RESOURCE_TYPES) — the app enforces them, this file only names them
 * in the docs an agent reads. Pinned against the app's own lists by
 * tabsCtlDescribe.test.ts, exactly like LIMITS, so adding a resource type in
 * the app fails a test instead of leaving this CLI quietly wrong.
 */
/** "a, b, or c" — how the docs above list an accepted vocabulary. */
function listOf(values) {
  return `${values.slice(0, -1).join(', ')}, or ${values[values.length - 1]}`
}

/**
 * Restated from EDITING_COMMANDS in
 * src/plugins/browser/shared/externalControl.ts — the app enforces the list,
 * this file only offers it. Pinned against the app's own by
 * tabsCtlDescribe.test.ts, like LIMITS and the network vocabularies.
 */
const EDITING_COMMANDS = ['select-all', 'undo', 'redo', 'delete']

const NETWORK_METHODS = [
  'GET',
  'HEAD',
  'POST',
  'PUT',
  'DELETE',
  'OPTIONS',
  'PATCH',
  'CONNECT',
  'TRACE'
]

const NETWORK_RESOURCE_TYPES = [
  'mainFrame',
  'subFrame',
  'stylesheet',
  'script',
  'image',
  'font',
  'object',
  'xhr',
  'ping',
  'cspReport',
  'media',
  'webSocket',
  'other'
]

const COMMANDS = {
