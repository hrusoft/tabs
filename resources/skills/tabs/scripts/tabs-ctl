    result: {
      ref: 'string',
      tag: 'string',
      rect: RECT,
      url: 'string'
    }
  },

  'save-resource': {
    request: 'saveResource',
    summary:
      'Save a page resource — a blob:/data:/http(s) URL, or an element’s src — to a local file and return the path (never the bytes). The way to get a PDF, image or any binary out of a page: save it, then read the file. Pass exactly one of --url, --ref, --selector.',
    flags: {
      pane: PANE_FLAG,
      url: { doc: 'A blob:, data:, http:, or https: URL to fetch.' },
      ref: { doc: 'A read-page ref whose element’s src/href is saved.' },
      selector: { placeholder: 'css', doc: 'A CSS selector whose element’s src/href is saved.' },
      out: {
        wire: 'outPath',
        type: 'path',
        placeholder: 'path',
        doc: 'Where to write it, resolved against your shell’s cwd. Default: a temp file swept after ~10 minutes.'
      }
    },
    // Exactly one of these names the resource; the app rejects a mismatch too,
    // but catching it here keeps a bad call off the socket entirely.
    oneOf: ['url', 'ref', 'selector'],
    result: { path: 'string', bytes: 'number', contentType: 'string' }
  },

  batch: {
    request: 'batch',
    summary:
      'Run several requests in order as one transcript. Stops at the first failure unless --continue-on-error.',
    flags: {
      // Raw protocol requests: the one command that isn't a friendlier wrapper
      // over the wire format, since its whole point is sending several at once.
      // `describe --command <name>` prints the wire shape for each verb.
      requests: {
        type: 'json',
        required: true,
        placeholder: 'json',
        schema: { type: 'array', maxItems: LIMITS.maxBatchRequests, items: { type: 'object' } }
      },
      'continue-on-error': {
        wire: 'continueOnError',
        type: 'boolean',
        doc: 'Run every step even after one fails; failures stay visible per step.'
      }
    },
    // `steps` is aligned index-for-index with `requests`; entries after the
    // failure that stopped the batch are `{"skipped": true}` markers.
    result: { steps: ['object'], stoppedAt: 'number' }
  }
}

/** Version of the `describe` payload itself, so a future shape change is detectable. */
const DESCRIBE_VERSION = 1

function parseArgs(argv) {
  const args = {}
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    if (!arg.startsWith('--')) continue
    // `--flag=value` binds unambiguously, and is the only way to pass a value
    // that itself begins with `--` (e.g. typing "--help" into a page).
    const eq = arg.indexOf('=')
    if (eq !== -1) {
      args[arg.slice(2, eq)] = arg.slice(eq + 1)
      continue
    }
    const next = argv[i + 1]
    // A flag with nothing of its own after it — end of argv, or immediately
    // followed by another flag — is a boolean switch (`--submit`,
    // `--unredacted`).
    if (next === undefined || next.startsWith('--')) {
      args[arg.slice(2)] = true
    } else {
      args[arg.slice(2)] = next
      i++
    }
  }
  return args
}

/**
 * Nothing in this file may call `process.exit()` after writing to stdout —
 * exitCode + a natural return is the only safe way out. When stdout is a pipe
 * (`| jq`, or any programmatic caller — i.e. how this script is actually run),
 * a hard exit drops everything the kernel's ~64KB pipe buffer hasn't drained
 * yet: the output ends mid-string with exit 0, which for a JSON protocol is
 * the worst possible failure. Measured: a 122KB get-page-text answered 65536
 * bytes through a pipe and the full length to a file. `process.exitCode` lets
 * the event loop live until pending stream writes finish, then exits with the
 * recorded code.
 */
function fail(error) {
  process.stdout.write(`${JSON.stringify({ ok: false, error })}\n`)
  process.exitCode = 1
}

/** Flags a command accepts, including the ones the ElementTarget builder consumes. */
function flagNames(spec) {
  return [
    ...Object.keys(spec.flags ?? {}),
    ...(spec.target ? ['ref', 'x', 'y', 'role', 'name', 'selector', 'nth'] : [])
  ]
}

function usageFor(name, spec) {
  const parts = [`tabs-ctl ${name}`]
  for (const [flag, def] of Object.entries(spec.flags ?? {})) {
    // An enum documents itself in the usage line, so it needs no placeholder
    // of its own — one less thing to keep in sync with the allowed values.
    const stand = def.placeholder ?? (def.enum ? def.enum.join('|') : flag)
    const value = def.type === 'boolean' ? '' : ` <${stand}>`
    parts.push(def.required ? `--${flag}${value}` : `[--${flag}${value}]`)
  }
  if (spec.target) {
    parts.push('(--role/--name/--selector [--nth <n>] | --ref <ref> | --x <n> --y <n>)')
  }
  return parts.join(' ')
}

/** Expands the shorthand used by `result` above into JSON Schema. */
function expandSchema(shorthand) {
  if (Array.isArray(shorthand)) return { type: 'array', items: expandSchema(shorthand[0]) }
  if (typeof shorthand === 'object') {
    const properties = {}
    for (const [key, value] of Object.entries(shorthand)) properties[key] = expandSchema(value)
    return { type: 'object', properties }
  }
  return { type: shorthand }
}

const WIRE_TYPES = { number: 'number', boolean: 'boolean', string: 'string' }

/**
 * JSON Schema for a command's protocol request — the shape `batch` takes, and
 * the shape an MCP tool definition would need if one is ever built.
 * `paneId` is deliberately absent: the app fills it in from the caller's
 * environment, and inside a batch it is overwritten regardless.
 */
function wireSchemaFor(spec) {
  const properties = { type: { const: spec.request } }
  const required = ['type']
  for (const [flag, def] of Object.entries(spec.flags ?? {})) {
    const key = def.wire ?? flag
    properties[key] = def.schema ?? { type: WIRE_TYPES[def.type] ?? 'string' }
    if (def.min !== undefined) properties[key] = { ...properties[key], minimum: def.min }
    if (def.enum) properties[key] = { enum: def.enum }
    if (def.required) required.push(key)
  }
  if (spec.target) {
    properties.target = TARGET_SCHEMA
    required.push('target')
  }
  return { type: 'object', properties, required, additionalProperties: false }
}

function describe(args) {
  if (typeof args.command === 'string') {
    const spec = COMMANDS[args.command]
    if (!spec) return fail(`unknown command: ${args.command}`)
    return describeOne(args.command, spec)
  }
  const commands = {}
  for (const [name, spec] of Object.entries(COMMANDS)) {
    commands[name] = args.full ? describeOne(name, spec) : `${usageFor(name, spec)}  — ${spec.summary}`
  }
  return { version: DESCRIBE_VERSION, limits: LIMITS, commands }
}

function describeOne(name, spec) {
  const flags = {}
  for (const [flag, def] of Object.entries(spec.flags ?? {})) {
    flags[flag] = {
      required: def.required === true,
      ...(def.type ? { type: def.type } : {}),
      ...(def.enum ? { enum: def.enum } : {}),
      ...(def.min !== undefined ? { min: def.min } : {}),
      ...(def.default !== undefined ? { default: def.default } : {}),
      ...(def.doc ? { doc: def.doc } : {})
    }
  }
  return {
    command: name,
    summary: spec.summary,
    usage: usageFor(name, spec),
    flags,
    ...(spec.target
      ? {
          target:
            'Pass any of --role/--name/--selector (matched in the page, failing if ambiguous; --nth <n> is a 0-based pick among the matches); or --ref from read-page/find; or both --x and --y (CSS pixels). The three forms do not mix.'
        }
      : {}),
    ...(spec.oneOf ? { oneOf: spec.oneOf.map((flag) => `--${flag}`) } : {}),
    wire: wireSchemaFor(spec),
    ...(spec.result ? { result: expandSchema(spec.result) } : {})
  }
}

/**
 * Validates `args` against a command's table entry and assembles its request.
 * Returns `{ error }` rather than exiting, so the caller owns the output shape.
 */
function buildRequest(command, args, paneId) {
  const spec = COMMANDS[command]
  if (!spec) {
    return { error: `unknown command: ${command || '(none)'} — run 'tabs-ctl describe' to list them` }
  }

  const known = new Set(flagNames(spec))
  for (const flag of Object.keys(args)) {
    if (!known.has(flag)) {
      const valid = [...known].map((f) => `--${f}`).join(', ') || '(none)'
      return { error: `unknown flag --${flag} for ${command}; accepts: ${valid}` }
    }
  }

  const request = { type: spec.request, paneId }
  for (const [flag, def] of Object.entries(spec.flags ?? {})) {
    const raw = args[flag] === undefined ? def.default : args[flag]
    if (raw === undefined) {
      if (def.required) {
        return { error: `--${flag} is required${def.type === 'json' ? ' (JSON)' : ''}` }
      }
      continue
    }
    if (def.enum && !def.enum.includes(raw)) {
      return { error: `--${flag} must be one of ${def.enum.join(', ')} (got ${raw})` }
    }

    const key = def.wire ?? flag
    if (def.type === 'number') {
      const value = Number(raw)
      if (Number.isNaN(value)) return { error: `--${flag} must be a number (got ${raw})` }
      // `min` closes the fail-open hole where garbage below a flag's floor
      // (--max-length -5) went over the wire and was silently ignored, while
      // the same garbage spelled non-numerically errored. Only for floors the
      // app doesn't own: --timeout/--poll have *documented* app-side clamps
      // and deliberately carry no min here.
      if (def.min !== undefined && value < def.min) {
        return { error: `--${flag} must be at least ${def.min} (got ${raw})` }
      }
      request[key] = value
    } else if (def.type === 'boolean') {
      // `value` lets a flag *invert* onto the wire (capture-bodies --off →
      // enabled: false); the wire default stays "flag absent, field absent".
      request[key] = def.value !== undefined ? def.value : true
    } else if (def.type === 'csv') {
      request[key] = String(raw).split(',').filter(Boolean)
    } else if (def.type === 'json') {
      let value
      try {
        value = JSON.parse(raw)
      } catch (error) {
        return { error: `--${flag} is not valid JSON: ${error.message}` }
      }
      if (def.schema?.type === 'array' && !Array.isArray(value)) {
        return { error: `--${flag} must be a JSON array` }
      }
      request[key] = value
    } else {
      request[key] = raw
    }
  }

  if (spec.target) {
    // The three target forms are mutually exclusive, and mixing them is
    // rejected rather than resolved by precedence: silently ignoring half of
    // what the caller passed is exactly the guess-not-fail behaviour the
    // semantic form exists to remove.
    const semanticFlags = ['role', 'name', 'selector'].filter((flag) => args[flag] !== undefined)
    const hasCoordFlag = args.x !== undefined || args.y !== undefined
    const forms = [
      args.ref !== undefined ? '--ref' : null,
      hasCoordFlag ? '--x/--y' : null,
      semanticFlags.length > 0 ? semanticFlags.map((flag) => `--${flag}`).join('/') : null
    ].filter(Boolean)
    if (forms.length > 1) {
      return { error: `${forms.join(' and ')} are different target forms — pass only one` }
    }
    if (args.nth !== undefined && semanticFlags.length === 0) {
      return { error: '--nth only applies to --role/--name/--selector targeting' }
    }

    if (args.ref !== undefined) request.target = { ref: args.ref }
    else if (hasCoordFlag) {
      if (args.x === undefined || args.y === undefined) {
        return { error: 'a coordinate target needs both --x and --y' }
      }
      const x = Number(args.x)
      const y = Number(args.y)
      // Same check the table gives every numeric flag: a NaN would serialize
      // as null on the wire and only fail far away, as an opaque input-event
      // error inside the app.
      if (Number.isNaN(x) || Number.isNaN(y)) {
        return { error: `--x and --y must be numbers (got ${args.x}, ${args.y})` }
      }
      request.target = { x, y }
    } else if (semanticFlags.length > 0) {
      const target = {}
      for (const flag of semanticFlags) {
        // A bare `--name` parses as boolean true; matching the string "true"
        // is never what that meant.
        if (typeof args[flag] !== 'string') return { error: `--${flag} needs a value` }
        target[flag] = args[flag]
      }
      if (args.nth !== undefined) {
        const nth = Number(args.nth)
        if (!Number.isInteger(nth) || nth < 0) {
          return { error: `--nth must be a non-negative integer (got ${args.nth})` }
        }
        target.nth = nth
      }
      request.target = target
    } else {
      return { error: '--role/--name/--selector, --ref, or both --x and --y is required' }
    }
  }

  // A `oneOf` command names its resource one of several mutually exclusive
  // ways (save-resource's --url/--ref/--selector) — exactly one, since zero
  // has nothing to act on and more than one is ambiguous.
  if (Array.isArray(spec.oneOf)) {
    const chosen = spec.oneOf.filter((flag) => args[flag] !== undefined)
    const list = spec.oneOf.map((flag) => `--${flag}`).join(', ')
    if (chosen.length === 0) return { error: `one of ${list} is required` }
    if (chosen.length > 1) {
      return { error: `pass only one of ${list} (got ${chosen.map((flag) => `--${flag}`).join(', ')})` }
    }
  }

  // A batch's sub-requests are raw wire JSON the caller assembled by hand —
  // the one place a typo'd verb name can slip past this parser — so check
  // each type against the same table before anything goes over the socket.
  if (spec.request === 'batch' && Array.isArray(request.requests)) {
    const knownTypes = new Set(Object.values(COMMANDS).map((entry) => entry.request))
    for (const [index, sub] of request.requests.entries()) {
      const type = sub && typeof sub === 'object' ? sub.type : undefined
      if (!knownTypes.has(type)) {
        return {
          error: `requests[${index}] has unknown type ${JSON.stringify(type ?? null)} — 'tabs-ctl describe --command <name>' prints each wire shape`
        }
      }
    }
  }

  return { request }
}

async function sendRequest(socketPath, request) {
  const { createConnection } = await import('node:net')
  return new Promise((resolve, reject) => {
    const socket = createConnection(socketPath, () => {
      socket.write(`${JSON.stringify(request)}\n`)
    })
    let buffer = ''
    socket.on('data', (chunk) => {
      buffer += chunk.toString('utf-8')
    })
    socket.on('end', () => {
      try {
        resolve(JSON.parse(buffer.trim()))
      } catch {
        reject(new Error(`malformed response from Tabs: ${buffer}`))
      }
    })
    socket.on('error', (error) => {
      reject(new Error(`could not reach Tabs: ${error.message}`))
    })
  })
}

/** Resolves every `path`-typed flag's value against the caller's cwd, in place. */
async function resolvePathFlags(command, request) {
  const spec = COMMANDS[command]
  if (!spec?.flags) return
  const pathFlags = Object.entries(spec.flags).filter(([, def]) => def.type === 'path')
  if (pathFlags.length === 0) return
  const { resolve } = await import('node:path')
  for (const [flag, def] of pathFlags) {
    const key = def.wire ?? flag
    if (typeof request[key] === 'string') request[key] = resolve(request[key])
  }
}

async function main() {
  const [command, ...rest] = process.argv.slice(2)
  const args = parseArgs(rest)

  // Answered before the environment check below: `describe` is local metadata,
  // not a socket call, and an agent should be able to learn the surface before
  // it has established that it's running inside Tabs at all.
  if (command === 'describe') {
    process.stdout.write(`${JSON.stringify(describe(args))}\n`)
    return
  }

  const paneId = process.env.TABS_PANE_ID
  const socketPath = process.env.TABS_CONTROL_SOCKET
  if (!paneId || !socketPath) {
    fail('not running inside a Tabs terminal pane (TABS_PANE_ID/TABS_CONTROL_SOCKET unset)')
    return
  }

  const built = buildRequest(command, args, paneId)
  if (built.error) return fail(built.error)

  // A `path` flag is a filesystem path in *this* shell's cwd; the app runs
  // elsewhere, so it can't resolve a relative one. Resolve to absolute here,
  // where the cwd is the caller's. Dynamic import for the same module-system
  // reason the socket connection uses one (see the note at the top).
  await resolvePathFlags(command, built.request)

  try {
    const response = await sendRequest(socketPath, built.request)
    process.stdout.write(`${JSON.stringify(response)}\n`)
    // A batch answers `ok: true` as long as it ran, so that the transcript it
    // collected survives alongside a failed step. Reflect a failed step in
    // the exit code anyway — including under --continue-on-error — so `&&` in
    // a shell still means what it looks like. Skipped steps carry no `ok` and
    // only ever follow a failed one, so checking `ok === false` covers them.
    const batchFailed =
      response.ok && Array.isArray(response.result?.steps)
        ? response.result.steps.some((step) => step.ok === false)
        : false
    // The same rule for a verb reporting per-part failures on an ok:true
    // response (form-input's errors array — the fields it did fill are the
    // useful part, batch's exact stance): a non-empty `errors` fails the exit
    // code too, so `&&` in a shell means every field landed.
    const partsFailed =
      response.ok && Array.isArray(response.result?.errors) && response.result.errors.length > 0
    // exitCode, never process.exit(): the response above may be far bigger
    // than the pipe buffer, and a hard exit truncates it — see fail()'s doc.
    process.exitCode = response.ok && !batchFailed && !partsFailed ? 0 : 1
  } catch (error) {
    fail(error.message)
  }
}

main()
