  'form-input': {
    request: 'formInput',
    summary:
      'Set field values verbatim (multiline safe), replacing existing contents. Exits non-zero when any field failed.',
    flags: {
      pane: PANE_FLAG,
      // JSON rather than repeated flags: a form is a list of (target, value)
      // pairs, and each target is itself a ref or a coordinate — not a shape
      // flat CLI arguments express well.
      fields: {
        type: 'json',
        required: true,
        placeholder: 'json',
        schema: {
          type: 'array',
          items: {
            type: 'object',
            properties: { target: TARGET_SCHEMA, value: { type: 'string' } },
            required: ['target', 'value'],
            additionalProperties: false
          }
