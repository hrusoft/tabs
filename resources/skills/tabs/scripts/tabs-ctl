#!/usr/bin/env node
'use strict'

// Deliberately no top-level `require`/`import` for node:net: once installed,
// this file is symlinked into an agent's own skills directory (see
// src/main/skills.ts), where whether Node treats an extension-less script as
// CommonJS or ESM depends on the nearest ancestor package.json — which
// varies by install location and isn't under this project's control. Dynamic
// `import()` inside an async function works under both module systems, so
// module-type detection can't break this script wherever it ends up.

/**
 * A dumb, stateless relay: turn `argv` into `{command, args}`, send it, print
 * whatever comes back. This file carries **no** knowledge of what any
 * command means — no flag types, no wire shapes, no validation beyond basic
 * argv parsing. The app resolves the command, coerces the flags, validates
 * the result, and answers with a `ControlResponse` (see
 * src/main/controlEnvelope.ts and src/main/externalControl.ts's
 * `handleEnvelope`). Run `tabs-ctl capabilities` for the command index, and
 * `tabs-ctl describe --capability <name>` for one capability's full
 * reference (flags, wire schema, result shape, guide) — both are ordinary
 * commands, answered the same way as everything else, because there is
 * nothing left in this file that could answer them offline.
 *
 * This means a version of this script always speaks whatever wire shape the
 * *app it's talking to* expects, for as long as both were built from the
 * same commit — which is the case for every ordinary use (the skill
 * directory is symlinked from the running app's own install; see
 * src/main/skills.ts). It does not protect against a stale CLI talking to an
 * app from a different build; that gap is accepted, not silently patched
 * over, and is why this file stays as thin as it does.
 */

/** `--flag value`, `--flag=value` (the only way to pass a value that itself starts with `--`, e.g. typing "--help" into a page), or a bare `--flag` (boolean `true`). */
function parseArgs(argv) {
  const args = {}
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    if (!arg.startsWith('--')) continue
    const eq = arg.indexOf('=')
    if (eq !== -1) {
      args[arg.slice(2, eq)] = arg.slice(eq + 1)
      continue
    }
    const next = argv[i + 1]
    if (next === undefined || next.startsWith('--')) {
      args[arg.slice(2)] = true
    } else {
      args[arg.slice(2)] = next
      i++
    }
  }
  return args
}

/**
 * Nothing in this file may call `process.exit()` after writing to stdout —
 * exitCode + a natural return is the only safe way out. When stdout is a pipe
 * (`| jq`, or any programmatic caller — i.e. how this script is actually run),
 * a hard exit drops everything the kernel's ~64KB pipe buffer hasn't drained
 * yet: the output ends mid-string with exit 0, which for a JSON protocol is
 * the worst possible failure. Measured: a 122KB get-page-text answered 65536
 * bytes through a pipe and the full length to a file. `process.exitCode` lets
 * the event loop live until pending stream writes finish, then exits with the
 * recorded code.
 */
function fail(error) {
  process.stdout.write(`${JSON.stringify({ ok: false, error })}\n`)
  process.exitCode = 1
}

/**
 * One socket round trip: write the envelope, read the first newline-terminated
 * line back. It answers on that line, not on the server closing the socket:
 * the Electron app closes after its one response, the native app's socket
 * serves any number of requests per connection and closes only when the client
 * does — waiting for the close would hang forever there. `setEncoding` (a
 * StringDecoder) rather than a per-chunk `toString`: a large answer arrives in
 * several chunks, and a multi-byte character split across a boundary would
 * otherwise decode as U+FFFD.
 */
async function sendEnvelope(socketPath, envelope) {
  const { createConnection } = await import('node:net')
  return new Promise((resolve, reject) => {
    const socket = createConnection(socketPath, () => {
      socket.write(`${JSON.stringify(envelope)}\n`)
    })
    socket.setEncoding('utf8')
    let buffer = ''
    let settled = false
    const settle = (text) => {
      if (settled) return
      settled = true
      try {
        resolve(JSON.parse(text.trim()))
      } catch {
        reject(new Error(`malformed response from Tabs: ${text}`))
      }
    }
    socket.on('data', (chunk) => {
      buffer += chunk
      const newline = buffer.indexOf('\n')
      if (newline === -1) return
      settle(buffer.slice(0, newline))
      socket.end()
    })
    // A server that closes without a newline (the last line, unterminated).
    socket.on('end', () => settle(buffer))
    socket.on('error', (error) => {
      if (settled) return
      settled = true
      reject(new Error(`could not reach Tabs: ${error.message}`))
    })
  })
}

async function main() {
  const paneId = process.env.TABS_PANE_ID
  const socketPath = process.env.TABS_CONTROL_SOCKET
  if (!paneId || !socketPath) {
    fail('not running inside a Tabs terminal pane (TABS_PANE_ID/TABS_CONTROL_SOCKET unset)')
    return
  }

  const [command, ...rest] = process.argv.slice(2)
  if (!command) {
    fail('usage: tabs-ctl <command> [--flag value ...] — run "tabs-ctl capabilities" to list commands')
    return
  }
  const args = parseArgs(rest)

  // `cwd` lets the app resolve any path-typed flag (--out, --body-out, ...)
  // against *this* shell's directory — the app runs elsewhere, so it can't
  // resolve a relative one itself. This script has no notion of which flags
  // are paths; the app's spec for the command does.
  const envelope = { command, args, paneId, cwd: process.cwd() }

  try {
    const response = await sendEnvelope(socketPath, envelope)
    process.stdout.write(`${JSON.stringify(response)}\n`)
    // A batch answers `ok: true` as long as it ran, so that the transcript it
    // collected survives alongside a failed step. Reflect a failed step in
    // the exit code anyway — including under --continue-on-error — so `&&` in
    // a shell still means what it looks like. Skipped steps carry no `ok` and
    // only ever follow a failed one, so checking `ok === false` covers them.
    const batchFailed =
      response.ok && Array.isArray(response.result?.steps)
        ? response.result.steps.some((step) => step.ok === false)
        : false
    // The same rule for a verb reporting per-part failures on an ok:true
    // response (form-input's errors array — the fields it did fill are the
    // useful part, batch's exact stance): a non-empty `errors` fails the exit
    // code too, so `&&` in a shell means every field landed.
    const partsFailed =
      response.ok && Array.isArray(response.result?.errors) && response.result.errors.length > 0
    // exitCode, never process.exit(): the response above may be far bigger
    // than the pipe buffer, and a hard exit truncates it — see fail()'s doc.
    process.exitCode = response.ok && !batchFailed && !partsFailed ? 0 : 1
  } catch (error) {
    fail(error.message)
  }
}

main()
